#!/bin/zsh
# cgpus v2.0.0
# Enhanced GPU monitoring tool with sparklines, CPU stats, and refresh mode
# Repository: https://github.com/leonlufkin/cgpus
#
# Usage: cgpus [--cpu] [-f [INTERVAL]] GROUP
# Example: cgpus2 zyphra
# Example: cgpus2 --cpu zyphra  (show CPU and host memory stats)
# Example: cgpus2 -f zyphra  (refresh every 30s)
# Example: cgpus2 -f 5 zyphra  (refresh every 5s)
# Example: cgpus2 --cpu -f 5 zyphra  (CPU stats with refresh)
# Enhanced version with power draw, utilization %, and memory usage per GPU

# Parse arguments for refresh mode
REFRESH_MODE=0
REFRESH_INTERVAL=30
CPU_MODE=0
GROUP=""

# Parse arguments flexibly
i=1
while [[ $i -le $# ]]; do
  arg="${@[$i]}"
  if [[ "$arg" == "--cpu" ]]; then
    CPU_MODE=1
  elif [[ "$arg" == "-f" ]]; then
    REFRESH_MODE=1
    # Check if next arg is a number (interval)
    next_i=$((i + 1))
    if [[ $next_i -le $# ]]; then
      next_arg="${@[$next_i]}"
      if [[ "$next_arg" =~ ^[0-9]+$ ]]; then
        REFRESH_INTERVAL="$next_arg"
        i=$next_i
      fi
    fi
  elif [[ -z "$GROUP" && "$arg" != -* ]]; then
    GROUP="$arg"
  fi
  i=$((i + 1))
done

# Validate arguments
if [[ -z "$GROUP" ]]; then
  echo "Usage: cgpus2 [--cpu] [-f [INTERVAL]] GROUP"
  echo "  --cpu         Show CPU load and host memory usage"
  echo "  -f            Enable refresh mode (default: 30s interval)"
  echo "  -f INTERVAL   Enable refresh mode with custom interval (seconds)"
  echo ""
  echo "Examples:"
  echo "  cgpus2 zyphra          # One-shot execution"
  echo "  cgpus2 --cpu zyphra    # Show CPU stats"
  echo "  cgpus2 -f zyphra       # Refresh every 30 seconds"
  echo "  cgpus2 -f 5 zyphra     # Refresh every 5 seconds"
  echo "  cgpus2 --cpu -f 5 zyphra  # CPU stats with refresh"
  exit 1
fi

if [[ $REFRESH_INTERVAL -lt 1 ]]; then
  echo "Error: Refresh interval must be at least 1 second"
  exit 1
fi

# Declare an associative array in zsh
source "${HOME}/.ssh/ssh_key_groups.sh"

if [[ -z "${GROUPS[$GROUP]}" ]]; then
  echo "Group '$GROUP' is not defined."
  exit 1
fi

# Global associative array to track power history for sparklines (refresh mode only)
typeset -gA POWER_HISTORY

# Global associative array to track last tag per host (for tag persistence)
typeset -gA LAST_TAG

# Temporary file to persist history across subshell calls
HISTORY_FILE=$(mktemp -t cgpus2_history.XXXXXX)

# Function to calculate maximum sparkline size based on current terminal width
calculate_sparkline_size() {
  local enable_cpu="${1:-0}"
  local term_width=${COLUMNS:-$(tput cols 2>/dev/null || echo 120)}

  # Base columns: host(6) + stats(38) + spaces(2) + max_gpu_id(~15 avg) = 61
  local fixed_width=61

  # Add CPU columns if enabled: spaces(2) + cpu%(4) + spaces(2) + mem(~8) = 16
  if [[ $enable_cpu -eq 1 ]]; then
    fixed_width=$((fixed_width + 16))
  fi

  local max_size=$(( term_width - fixed_width - 4 ))
  [[ $max_size -gt 20 ]] && max_size=20
  [[ $max_size -lt 5 ]] && max_size=5  # Minimum of 5
  echo "$max_size"
}

# Function to generate sparkline from power history with colors
generate_sparkline() {
  local history="$1"
  local sparkline=""
  local blocks=(' ' ▂ ▃ ▄ ▅ ▆ ▇ █)
  local RED='\033[31m'
  local YELLOW='\033[33m'
  local RESET='\033[0m'

  # Process each entry in history (format: "power:color" or just "power" for backward compat)
  for entry in ${(z)history}; do
    if [[ "$entry" == "-1" || "$entry" == "-1:"* ]]; then
      # Data was not available for this iteration
      sparkline="${sparkline} "
    else
      # Parse power and color (handle both "power:color" and legacy "power" format)
      local pwr="${entry%%:*}"
      local clr="none"
      if [[ "$entry" == *:* ]]; then
        clr="${entry##*:}"
      fi

      # Map 0-700W to 0-7 index
      local index=$(( (pwr * 7) / 700 ))
      # Clamp to valid range
      [[ $index -lt 0 ]] && index=0
      [[ $index -gt 7 ]] && index=7

      # Get block character (zsh arrays are 1-indexed)
      local block="${blocks[$((index + 1))]}"

      # Apply color based on historical state
      if [[ "$clr" == "red" ]]; then
        sparkline="${sparkline}${RED}${block}${RESET}"
      elif [[ "$clr" == "yellow" ]]; then
        sparkline="${sparkline}${YELLOW}${block}${RESET}"
      else
        sparkline="${sparkline}${block}"
      fi
    fi
  done

  echo "$sparkline"
}

# Function to check GPUs for a given group
check_gpus() {
  local GROUP="$1"
  local enable_history="$2"  # 1 = track history, 0 = don't track
  local max_history="${3:-20}"  # Max history size, default 20
  local enable_cpu="${4:-0}"  # 1 = show CPU stats, 0 = don't show

  # Validate group exists
  if [[ -z "${GROUPS[$GROUP]}" ]]; then
    echo "Group '$GROUP' is not defined."
    return 1
  fi

  # Convert the string to an array by splitting on whitespace.
  local nodes=(${(s: :)GROUPS[$GROUP]})

  # Create a temporary directory to hold the results.
  local tmp_dir=$(mktemp -d -t check_gpus_results)

  # Launch asynchronous SSH commands and store each result in a temporary file.
  for host in $nodes; do
    (
      result=$(ssh -o BatchMode=yes -o ConnectTimeout=5 "$host" \
        "enable_cpu=$enable_cpu; "'command -v nvidia-smi >/dev/null 2>&1 && {
          total=$(nvidia-smi -L | wc -l)

          # Collect CPU load and memory if CPU mode is enabled
          if [[ $enable_cpu -eq 1 ]]; then
            # Get actual CPU utilization percentage (not load average)
            # Use top with batch mode to get CPU idle, then calculate used
            cpu_idle=$(top -bn2 -d0.1 2>/dev/null | grep "Cpu(s)" | tail -1 | awk '\''{for(i=1;i<=NF;i++) if($i~/id/) print $(i-1)}'\'' | cut -d'\''%'\'' -f1)
            if [[ -n "$cpu_idle" && "$cpu_idle" != "0" ]]; then
              # Use awk for proper rounding with leading zeros
              cpu_pct=$(awk -v idle="$cpu_idle" '\''BEGIN {printf "%.0f", 100 - idle}'\'' 2>/dev/null || echo "0")
            else
              cpu_pct="0"
            fi

            # Get memory in GB, convert to TB with conditional decimal formatting
            mem_total_gb=$(free -g 2>/dev/null | awk '\''/^Mem:/ {print $2}'\'' || echo "0")
            mem_used_gb=$(free -g 2>/dev/null | awk '\''/^Mem:/ {print $3}'\'' || echo "0")

            # Calculate TB values
            mem_total_tb_raw=$(echo "scale=2; $mem_total_gb / 1024" | bc 2>/dev/null || echo "0")
            mem_used_tb_raw=$(echo "scale=2; $mem_used_gb / 1024" | bc 2>/dev/null || echo "0")

            # Format with 1 decimal if < 1 TB, otherwise as integer
            if (( $(echo "$mem_total_tb_raw < 1" | bc -l) )); then
              mem_total_tb=$(printf "%.1f" $mem_total_tb_raw)
            else
              mem_total_tb=$(printf "%.0f" $mem_total_tb_raw)
            fi

            if (( $(echo "$mem_used_tb_raw < 1" | bc -l) )); then
              mem_used_tb=$(printf "%.1f" $mem_used_tb_raw)
            else
              mem_used_tb=$(printf "%.0f" $mem_used_tb_raw)
            fi

            cpu_mem_stats="${cpu_pct}|${mem_used_tb}|${mem_total_tb}"
          else
            cpu_mem_stats=""
          fi

          # Get detailed stats for each GPU
          gpu_stats=$(nvidia-smi --query-gpu=index,memory.used,memory.total,utilization.gpu,power.draw --format=csv,noheader,nounits | awk '\''BEGIN {
            FS=","
            idle_count=0
            busy_count=0
            total_power=0
            total_util=0
            total_mem_used=0
            total_mem_total=0
            gpu_count=0
          }
          {
            gpu_count++
            gpu_index=int($1)
            mem_used=$2
            mem_total=$3
            util=$4
            power=$5

            # Store yellow status for each GPU
            yellow[gpu_index] = 0

            # Accumulate stats for ALL GPUs
            total_util += util
            total_power += power
            total_mem_used += mem_used
            total_mem_total += mem_total

            # GPU is idle if: power < 100W AND memory < 1GB AND util < 5%
            if (power < 100 && mem_used < 1024 && util < 5) {
              idle_count++
            } else {
              busy_count++
            }

            # Check yellow condition for this individual GPU
            spare_mem_gpu = (mem_total - mem_used) / 1024
            if (spare_mem_gpu > 40 || power < 250) {
              yellow[gpu_index] = 1
            }
          }
          END {
            if (gpu_count > 0) {
              # Compute averages over ALL GPUs
              avg_util = total_util / gpu_count
              avg_power = total_power / gpu_count
              mem_used_gb = (total_mem_used / 1024) / gpu_count
              mem_total_gb = (total_mem_total / 1024) / gpu_count

              # Build yellow GPU list with range collapsing
              yellow_str = ""
              range_start = -1
              range_end = -1
              for (i = 0; i < gpu_count; i++) {
                if (yellow[i] == 1) {
                  if (range_start == -1) {
                    range_start = i
                    range_end = i
                  } else if (i == range_end + 1) {
                    range_end = i
                  } else {
                    # End previous range and start new one
                    if (yellow_str != "") yellow_str = yellow_str ","
                    if (range_start == range_end) {
                      yellow_str = yellow_str range_start
                    } else {
                      yellow_str = yellow_str range_start "-" range_end
                    }
                    range_start = i
                    range_end = i
                  }
                }
              }
              # Flush final range
              if (range_start != -1) {
                if (yellow_str != "") yellow_str = yellow_str ","
                if (range_start == range_end) {
                  yellow_str = yellow_str range_start
                } else {
                  yellow_str = yellow_str range_start "-" range_end
                }
              }

              printf "%d/%d|%.0f|%.1f|%.1f|%.0f|%s", idle_count, gpu_count, avg_util, avg_power, mem_used_gb, mem_total_gb, yellow_str
            }
          }'\'')

          # Check process tags based on owner and name
          # Tags are applied only if ALL processes on GPUs match exactly one criterion
          process_tag=""

          # Get all process data at once
          process_data=$(nvidia-smi --query-compute-apps=pid,process_name --format=csv,noheader,nounits 2>/dev/null)

          if [[ -n "$process_data" ]]; then
            # Assume all conditions are true initially
            check_leon=1
            check_ray=1
            check_cmoe=1
            check_au=1
            check_da=1
            num_processes=0

            # Store process data in a temp file to avoid subshell issues
            echo "$process_data" > /tmp/gpu_procs_$$

            while IFS=, read -r pid proc_name; do
              num_processes=$((num_processes + 1))

              # Trim whitespace from pid
              pid=$(echo "$pid" | tr -d '\'' '\'' '')
              # Don'\''t trim proc_name to preserve full name

              # Get owner and full command line
              owner=$(ps -o user= -p "$pid" 2>/dev/null | tr -d '\'' '\'' '')
              cmd_line=$(ps -o args= -p "$pid" 2>/dev/null)

              # Check conditions - set to 0 if ANY process fails the check
              [[ "$owner" != "leon" ]] && check_leon=0
              [[ "$proc_name" != *"ray::WorkerDict"* && "$owner" != "pritish" ]] && check_ray=0
              [[ "$cmd_line" != *"cmoe"* ]] && check_cmoe=0
              [[ "$cmd_line" != *"lisan.al_gaib"* && "$cmd_line" != *"zonos"* ]] && check_au=0
              [[ "$owner" != "xiao" && "$cmd_line" != *"dataInfra"* ]] && check_da=0
            done < /tmp/gpu_procs_$$

            rm -f /tmp/gpu_procs_$$

            if [[ $num_processes -eq 0 ]]; then
              # No processes - leave process_tag empty (will use last tag)
              process_tag=""
            else
              # Count how many conditions passed for ALL processes
              tag_count=$((check_leon + check_ray + check_cmoe + check_au + check_da))

              # Only set tag if exactly one condition is true for ALL processes
              if [[ $tag_count -eq 1 ]]; then
                [[ $check_leon -eq 1 ]] && process_tag="*"
                [[ $check_ray -eq 1 ]] && process_tag="RL"
                [[ $check_cmoe -eq 1 ]] && process_tag="CM"
                [[ $check_au -eq 1 ]] && process_tag="AU"
                [[ $check_da -eq 1 ]] && process_tag="DA"
              elif [[ $tag_count -gt 1 ]]; then
                # Multiple tags match all processes - this is a conflict
                process_tag="MIXED"
              else
                # No tags match all processes
                process_tag="NONE"
              fi
            fi
          fi

          if [[ -n "$cpu_mem_stats" ]]; then
            echo "${gpu_stats}|${process_tag}|${cpu_mem_stats}"
          else
            echo "${gpu_stats}|${process_tag}"
          fi
        } || echo "-"' 2>/dev/null)
      if [[ $? -ne 0 ]] || [[ -z "$result" ]]; then
        echo "-" > "$tmp_dir/$host"
      else
        echo "$result" > "$tmp_dir/$host"
      fi
    ) &
  done

  # Wait for all background tasks to complete.
  wait

  # ANSI escape sequences for colors
  local RED='\033[31m'
  local YELLOW='\033[33m'
  local RESET='\033[0m'

  # First pass: calculate max GPU ID field width
  local max_gpu_id_len=10  # Minimum width
  for host in $nodes; do
    result=$(<"$tmp_dir/$host")
    if [[ -z "${result// /}" ]]; then
      result="-"
    fi

    if [[ "$result" == *"|"* ]]; then
      # Parse to get yellow_gpus field
      local yellow_gpus_field=""
      if [[ $enable_cpu -eq 1 ]]; then
        IFS='|' read -r _ _ _ _ _ yellow_gpus_field _ _ _ _ <<< "$result"
      else
        IFS='|' read -r _ _ _ _ _ yellow_gpus_field _ <<< "$result"
      fi

      if [[ -n "$yellow_gpus_field" ]]; then
        local yellow_section_len=$((${#yellow_gpus_field} + 2))  # +2 for parentheses
        if [[ $yellow_section_len -gt $max_gpu_id_len ]]; then
          max_gpu_id_len=$yellow_section_len
        fi
      fi
    fi
  done

  # Second pass: Print the results in the original order, one line per node.
  for host in $nodes; do
    result=$(<"$tmp_dir/$host")

    # Replace empty or whitespace-only result with dash
    if [[ -z "${result// /}" ]]; then
      result="-"
    fi

    # Update history for ALL nodes (even inaccessible ones) if tracking is enabled
    if [[ $enable_history -eq 1 ]]; then
      if [[ "$result" == *"|"* ]]; then
        # Node is accessible - we'll add actual power data below
        :
      else
        # Node is inaccessible - add -1 marker to history
        local history="${POWER_HISTORY[$host]:-}"
        local new_history=""
        if [[ -n "$history" ]]; then
          local values=(${=history} -1)  # Use ${=history} for explicit word splitting
          if [[ ${#values[@]} -gt $max_history ]]; then
            new_history="${values[@]: -$max_history}"
          else
            new_history="${values[@]}"
          fi
        else
          new_history="-1"
        fi
        POWER_HISTORY[$host]="$new_history"
      fi
    fi

    # If result contains pipe-delimited stats, parse and format
    if [[ "$result" == *"|"* ]]; then
      # Parse the pipe-delimited format: available/total|util|power|mem_used_gb|mem_total_gb|yellow_gpu_ids|process_tag[|cpu_pct|host_mem_used_tb|host_mem_total_tb]
      if [[ $enable_cpu -eq 1 ]]; then
        IFS='|' read -r avail_info util power mem_used mem_total yellow_gpus process_tag cpu_pct host_mem_used_tb host_mem_total_tb <<< "$result"
      else
        IFS='|' read -r avail_info util power mem_used mem_total yellow_gpus process_tag <<< "$result"
      fi
      available=${avail_info%%/*}

      # Apply tag persistence logic
      if [[ "$process_tag" == "MIXED" || "$process_tag" == "NONE" ]]; then
        # Conflict or unmatched processes - clear last tag and show nothing
        LAST_TAG[$host]=""
        process_tag=""
      elif [[ -z "$process_tag" ]]; then
        # No processes - use last tag if available
        process_tag="${LAST_TAG[$host]:-}"
      else
        # Specific tag determined - update last tag
        LAST_TAG[$host]="$process_tag"
      fi

      # Add process tag if applicable (with space before tag)
      if [[ -n "$process_tag" ]]; then
        avail_info="${avail_info} ${process_tag}"
      fi

      # Format the output as columns (use fixed-width numeric formatting)
      formatted=$(printf "%-7s %4.0f%% %7.1fW  %5.1f/%2.0f GB" "$avail_info" "$util" "$power" "$mem_used" "$mem_total")

      # Add yellow GPU IDs in parens if any exist, with dynamic padding for alignment
      local yellow_section=""
      if [[ -n "$yellow_gpus" ]]; then
        yellow_section="($yellow_gpus)"
      fi

      # Use calculated max_gpu_id_len for padding
      formatted="$formatted  $(printf "%-${max_gpu_id_len}s" "$yellow_section")"

      # Add CPU stats if in CPU mode
      if [[ $enable_cpu -eq 1 ]]; then
        formatted="$formatted  $(printf '%3s%%' "$cpu_pct")  ${host_mem_used_tb}/${host_mem_total_tb} TB"
      fi

      # Determine row color based on current state: red for any idle GPUs, yellow for yellow GPUs (if no idle)
      local row_color=""
      if [[ "$available" =~ ^[0-9]+$ ]] && (( available > 0 )); then
        # Red: at least one GPU is idle (strict condition)
        row_color="$RED"
      elif [[ -n "$yellow_gpus" ]]; then
        # Yellow: at least one GPU meets yellow condition (and no idle GPUs)
        row_color="$YELLOW"
      fi
      # Otherwise, row_color remains empty (white/default)

      # Store formatted string without sparkline
      local formatted_base="$formatted"
      local sparkline_str=""

      # Add sparkline if history tracking is enabled
      if [[ $enable_history -eq 1 ]]; then
        # Determine color for this time point (for history storage)
        local hist_color="none"
        if [[ "$available" =~ ^[0-9]+$ ]] && (( available > 0 )); then
          hist_color="red"
        elif [[ -n "$yellow_gpus" ]]; then
          hist_color="yellow"
        fi

        # Update power history for this host using avg_power with color
        local history="${POWER_HISTORY[$host]:-}"
        local new_history=""
        local new_entry="${power}:${hist_color}"

        if [[ -n "$history" ]]; then
          # Append new value and keep last max_history values
          local values=(${=history} $new_entry)  # Use ${=history} for explicit word splitting
          # Take last max_history values
          if [[ ${#values[@]} -gt $max_history ]]; then
            new_history="${values[@]: -$max_history}"
          else
            new_history="${values[@]}"
          fi
        else
          # First value
          new_history="$new_entry"
        fi

        POWER_HISTORY[$host]="$new_history"

        # Generate sparkline with proper spacing
        sparkline_str=$(generate_sparkline "$new_history")
        if [[ $enable_cpu -eq 1 ]]; then
          sparkline_str="   $sparkline_str"  # Extra space before sparkline in CPU mode
        else
          sparkline_str=" $sparkline_str"
        fi
      fi

      # Print: apply row color only to base, sparkline has its own colors
      if [[ -n "$row_color" ]]; then
        printf "%-6s %b%s%b%s\n" "$host:" "$row_color" "$formatted_base" "$RESET" "$sparkline_str"
      else
        printf "%-6s %s%s\n" "$host:" "$formatted_base" "$sparkline_str"
      fi
    else
      # Handle error messages or non-standard output
      local output="$result"

      # Add sparkline if history exists and tracking is enabled
      if [[ $enable_history -eq 1 ]] && [[ -n "${POWER_HISTORY[$host]:-}" ]]; then
        # Calculate padding dynamically based on max_gpu_id_len
        # Base: avail(7) + util(5) + power(9) + mem(15) + spaces(2) = 38
        # Plus: 2 spaces + max_gpu_id_len
        local base_width=$((38 + 2 + max_gpu_id_len))
        if [[ $enable_cpu -eq 1 ]]; then
          # Add: 2 spaces + cpu%(4) + 2 spaces + mem(~8 avg) = 16
          base_width=$((base_width + 16))
        fi
        output=$(printf "%-${base_width}s" "$output")
        local sparkline=$(generate_sparkline "${POWER_HISTORY[$host]}")
        output="$output$sparkline"
      fi

      printf "%-6s %s\n" "$host:" "$output"
    fi
  done

  # Clean up the temporary directory.
  rm -r "$tmp_dir"
}

# Main execution
if [[ $REFRESH_MODE -eq 0 ]]; then
  # One-shot mode: just run once and exit
  check_gpus "$GROUP" 0 "$(calculate_sparkline_size $CPU_MODE)" "$CPU_MODE"
  rm -f "$HISTORY_FILE"
else
  # Refresh mode: loop with status line at bottom
  trap 'echo ""; rm -f "$HISTORY_FILE"; exit 0' INT TERM

  iteration=0
  first_run=1

  while true; do
    iteration=$((iteration + 1))

    # Sleep first (except on first iteration) - keeps old output visible
    if [[ $first_run -eq 0 ]]; then
      # Calculate elapsed time and sleep for remaining interval
      end_time=$(date +%s)
      elapsed=$((end_time - start_time))
      remaining=$((REFRESH_INTERVAL - elapsed))

      if [[ $remaining -gt 0 ]]; then
        sleep "$remaining"
      fi
    fi
    first_run=0

    # Record start time
    start_time=$(date +%s)

    # Run check and save to temp file (old output still visible during this)
    local output_file=$(mktemp -t cgpus_output)
    local sparkline_size=$(calculate_sparkline_size $CPU_MODE)
    check_gpus "$GROUP" 1 "$sparkline_size" "$CPU_MODE" > "$output_file"

    # Clear screen and immediately display new output (no blank screen)
    printf '\033[2J\033[H'
    cat "$output_file"
    rm -f "$output_file"

    # Display bottom status line
    current_time=$(date +%H:%M:%S)
    printf "\nRefresh: %ds | Iteration: %d | Time: %s | Press Ctrl+C to exit" \
      "$REFRESH_INTERVAL" "$iteration" "$current_time"
  done
fi
