#!/bin/bash
# cgpus launcher
# Select backend via CGPUS_BACKEND=auto|zsh|go (default: auto)

set -o pipefail

backend="${CGPUS_BACKEND:-auto}"

src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  link_dir="$(cd -P "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  [[ "$src" != /* ]] && src="$link_dir/$src"
done
script_dir="$(cd -P "$(dirname "$src")" && pwd)"

zsh_backend="$script_dir/cgpus-zsh"
go_backend="$script_dir/cgpus-go"
go_compiled_backend="$script_dir/.bin/cgpus-go"

run_zsh() {
  if [[ ! -x "$zsh_backend" ]]; then
    echo "zsh backend not found or not executable: $zsh_backend" >&2
    return 1
  fi
  if ! command -v zsh >/dev/null 2>&1; then
    echo "zsh backend requires zsh to be installed" >&2
    return 1
  fi
  exec "$zsh_backend" "$@"
}

run_go() {
  if [[ ! -x "$go_backend" ]]; then
    echo "go backend not found or not executable: $go_backend" >&2
    return 1
  fi
  exec "$go_backend" "$@"
}

can_use_go_backend() {
  if [[ ! -x "$go_backend" ]]; then
    return 1
  fi

  if [[ -x "$go_compiled_backend" ]]; then
    return 0
  fi

  command -v go >/dev/null 2>&1
}

case "$backend" in
  zsh)
    run_zsh "$@"
    ;;
  go)
    run_go "$@"
    ;;
  auto)
    if can_use_go_backend; then
      run_go "$@"
    fi
    run_zsh "$@"
    ;;
  *)
    echo "Invalid CGPUS_BACKEND value: $backend (expected auto|zsh|go)" >&2
    exit 1
    ;;
esac
